---
import LandingLayout from '../layouts/LandingLayout.astro';
import { BOOKING } from '../config';

const { formId, embedHost } = BOOKING.metaCapture;
const iframeId = `inline-${formId}`;
const formSrc = `${embedHost}/widget/form/${formId}`;
const embedScriptSrc = `${embedHost}/js/form_embed.js`;
---

<LandingLayout
  title="Now Accepting New Patients | Highland Primary Care"
  description="Board-certified providers in Sherman, TX. Same-day and same-week appointments available."
>
  <script slot="head" is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('set','autoConfig',false,'812623817653317');
    fbq('init','812623817653317');
    fbq('track','PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=812623817653317&ev=PageView&noscript=1" /></noscript>

  <section class="mx-auto max-w-2xl px-4 pb-8 pt-3 sm:pt-6">
    <h1 class="text-2xl font-extrabold tracking-[-0.025em] sm:text-4xl">
      Now Accepting New Patients in Sherman
    </h1>
    <p class="mb-0 mt-1.5 text-[0.95rem] leading-snug sm:mt-3 sm:text-lg">
      Board-certified providers. Same-day and same-week appointments available.
    </p>
    <p class="mb-0 mt-3 text-[0.95rem] leading-snug text-ink-900 sm:mt-5">
      <strong>Step 1 of 2:</strong> Tell us who you are. Next, you'll pick your appointment time.
    </p>

    <div class="mt-2 sm:mt-4">
      <iframe
        style="width:100%;height:100%;border:none;border-radius:8px"
        data-src={formSrc}
        id={iframeId}
        data-layout="{'id':'INLINE'}"
        data-trigger-type="alwaysShow"
        data-trigger-value=""
        data-activation-type="alwaysActivated"
        data-activation-value=""
        data-deactivation-type="neverDeactivate"
        data-deactivation-value=""
        data-form-name="Meta Booking Capture"
        data-height="1041"
        data-layout-iframe-id={iframeId}
        data-form-id={formId}
        data-cookie-consent="true"
        data-cookie-consent-provider="auto"
        title="Meta Booking Capture"></iframe>
      <script is:inline>
        (function () {
          var f = document.currentScript.previousElementSibling;
          if (!f || f.tagName !== 'IFRAME' || f.getAttribute('src')) return;
          var base = f.getAttribute('data-src');
          var q = window.location.search.replace(/^\?/, '');
          f.src = q ? base + (base.indexOf('?') === -1 ? '?' : '&') + q : base;
        })();
      </script>
      <script is:inline src={embedScriptSrc}></script>
    </div>

    <p class="mb-0 mt-4 text-center text-sm text-ink-500">
      Prefer to call?
      <a id="call-fallback" href="tel:+19038715671" class="font-semibold text-ink-900 underline"
        >(903) 871-5671</a
      >
    </p>
    <script is:inline>
      // Meta traffic gets the Meta tracking line; the choice is kept for the session so
      // /book/next/ shows the same number. The HTML default (5671) is the no-JS fallback.
      (function () {
        var p = new URLSearchParams(window.location.search);
        var fromMeta = p.has('fbclid') || (p.get('utm_source') || '').toLowerCase() === 'facebook';
        var line = fromMeta ? '1256' : '5671';
        try {
          if (fromMeta || !sessionStorage.getItem('hpc_call_line')) {
            sessionStorage.setItem('hpc_call_line', line);
          }
          line = sessionStorage.getItem('hpc_call_line');
        } catch (e) {}
        if (line !== '1256') return;
        var a = document.getElementById('call-fallback');
        a.href = 'tel:+19038711256';
        a.textContent = '(903) 871-1256';
      })();
    </script>

    <p class="mb-0 mt-6 text-center text-sm text-ink-500">
      Highland Primary Care · 300 N Highland Ave, Suite 455, Sherman, TX 75092
    </p>
  </section>
</LandingLayout>
