---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { BOOKING } from '../../config';

const { healowUrl } = BOOKING.metaCapture;
---

<LandingLayout
  title="Choose Your Appointment Time | Highland Primary Care"
  description="Step 2 of 2: choose your appointment time at Highland Primary Care in Sherman, TX."
>
  <link slot="head" rel="preconnect" href="https://healow.com" />
  <script slot="head" is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('set','autoConfig',false,'812623817653317');
    fbq('init','812623817653317');
    fbq('track','PageView');
    fbq('trackCustom','BookStep2');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=812623817653317&ev=PageView&noscript=1" /></noscript>

  <section class="mx-auto max-w-2xl px-4 pb-8 pt-5 sm:pt-10">
    <p class="mb-1 text-sm font-bold text-ink-500">Step 2 of 2</p>
    <h1 class="text-2xl font-extrabold tracking-[-0.025em] sm:text-4xl">You're in. One more step.</h1>
    <p class="mb-0 mt-3 text-[0.95rem] leading-snug sm:text-lg">
      Choose your appointment time on our secure scheduling system. It can take up to 20 seconds to
      load — please keep this screen open.
    </p>

    <a
      id="healow-cta"
      href={healowUrl}
      class="mt-6 flex w-full items-center justify-center rounded-lg px-6 py-4 text-center text-lg font-semibold text-white sm:inline-flex sm:w-auto"
      style="background-color:#155EEF"
    >See Open Appointment Times</a>
    <script is:inline>
      (function () {
        var a = document.getElementById('healow-cta');
        var label = a.textContent;
        var busy = false;
        a.addEventListener('click', function (e) {
          if (busy) {
            e.preventDefault();
            return;
          }
          busy = true;
          a.textContent = 'Loading scheduler…';
          a.setAttribute('aria-busy', 'true');
          a.style.opacity = '0.85';
        });
        // Back button restores this page from bfcache; reset so the button works again.
        window.addEventListener('pageshow', function (e) {
          if (!e.persisted) return;
          busy = false;
          a.textContent = label;
          a.removeAttribute('aria-busy');
          a.style.opacity = '';
        });
      })();
    </script>

    <p class="mb-0 mt-4 text-center text-sm text-ink-500 sm:text-left">
      Prefer to call?
      <a id="call-fallback" href="tel:+19038715671" class="font-semibold text-ink-900 underline"
        >(903) 871-5671</a
      >
    </p>
    <script is:inline>
      // Same number /book/ chose for this session (sessionStorage); falls back to this URL's own
      // params (same rule: utm_source=facebook AND utm_medium=cpc), then the HTML default (5671).
      (function () {
        var line = null;
        try {
          line = sessionStorage.getItem('hpc_call_line');
        } catch (e) {}
        if (!line) {
          var p = new URLSearchParams(window.location.search);
          line =
            (p.get('utm_source') || '').toLowerCase() === 'facebook' &&
            (p.get('utm_medium') || '').toLowerCase() === 'cpc'
              ? '1256'
              : '5671';
        }
        if (line !== '1256') return;
        var a = document.getElementById('call-fallback');
        a.href = 'tel:+19038711256';
        a.textContent = '(903) 871-1256';
      })();
    </script>

    <p class="mb-0 mt-8 text-center text-sm text-ink-500">
      Highland Primary Care · 300 N Highland Ave, Suite 455, Sherman, TX 75092
    </p>
  </section>
</LandingLayout>
